# Copy thành .env rồi điền giá trị. Không commit .env.
# Ý nghĩa từng biến: docs/specs/01-core.md (pipeline), docs/specs/13-deploy.md (Docker stack).

# --- Pipeline ---
# Máy dev: ./data. Server bee: /data/alphadata
ALPHADATA_ROOT=./data
# Máy dev: bỏ trống để dùng SQLite trong ALPHADATA_ROOT. Server bee: Postgres DB alphadata_meta
ALPHADATA_META_DB_URL=
ALPHADATA_MIN_FREE_GB=3
ALPHADATA_HTTP_TIMEOUT=60
ALPHADATA_UNIVERSE_DIR=./config/universe
# SEC bắt buộc có email liên hệ trong User-Agent
ALPHADATA_USER_AGENT=alphadata/0.2 (internal research; change-me@example.com)

# --- API key của nguồn (đăng ký miễn phí) ---
FRED_API_KEY=
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
EIA_API_KEY=
BEA_API_KEY=
BLS_API_KEY=

# --- Docker stack (chỉ cần trên server) ---
POSTGRES_PASSWORD=change-me
ALPHADATA_META_PASSWORD=change-me
AIRFLOW_ADMIN_PASSWORD=change-me

# --- Alert ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
