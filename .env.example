# Thư mục gốc chứa raw/ và silver/. Trên server bee: /data/alphadata
ALPHADATA_ROOT=./data

# DB lưu metadata (lịch sử chạy, kết quả DQ, catalog bảng).
# Mặc định: SQLite trong ALPHADATA_ROOT. Trên server: Postgres, ví dụ
# ALPHADATA_META_DB_URL=postgresql+psycopg2://alphadata:alphadata@postgres/alphadata
ALPHADATA_META_DB_URL=

# Pipeline dừng nếu disk trống ít hơn số GB này
ALPHADATA_MIN_FREE_GB=3

ALPHADATA_HTTP_TIMEOUT=60

# --- Chỉ dùng cho docker compose trên server ---
# Thư mục trên server chứa data, mount vào container
ALPHADATA_HOST_DIR=/data/alphadata
POSTGRES_PASSWORD=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Chuỗi ngẫu nhiên dài, ví dụ: openssl rand -hex 32
AIRFLOW_JWT_SECRET=change-me

# API key của các nguồn (miễn phí)
# FRED: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
